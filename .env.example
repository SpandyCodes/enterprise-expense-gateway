# --- Database ---
POSTGRES_USER=expense_user
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=expense_gateway
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://expense_user:change_me_locally@postgres:5432/expense_gateway

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth / JWT (local OAuth2-style demonstration ONLY) ---
JWT_SECRET_KEY=change_me_to_a_long_random_value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- mTLS ---
MTLS_CA_CERT_PATH=/certs/ca/ca.crt
MTLS_SERVER_CERT_PATH=/certs/server/server.crt
MTLS_SERVER_KEY_PATH=/certs/server/server.key

# --- App ---
APP_ENV=local
LOG_LEVEL=INFO
CORRELATION_ID_HEADER=X-Correlation-Id

# --- Retry policy ---
INTEGRATION_MAX_RETRIES=3
INTEGRATION_BACKOFF_BASE_SECONDS=1
